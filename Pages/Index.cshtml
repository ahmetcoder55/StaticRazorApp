@page
@model IndexModel
@{
    ViewData["Title"] = "Ürün Kataloğu";

}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Geliştirici Ekipmanları</h1>
        <p class="lead text-muted">StaticContext ve Seeding mimarisiyle listelenen mock ürün kataloğu.</p>
        <hr class="w-25 mx-auto" />
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.Products != null && Model.Products.Any())
        {
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <img src="@product.ImageUrl" asp-append-version="true" class="card-img-top" alt="@product.Name"
                             style="height: 220px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2"> <span
                                class="text-muted small">Stok: @product.Stock</span>
                            </div>

                            <h5 class="card-title fw-bold text-dark">@product.Name</h5>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.95rem;">
                                @product.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="fs-5 fw-bold text-success">@product.Price.ToString("C2")</span>
                                <a asp-page="ProductDetail" asp-route-id="@product.Id"
                                   class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Detayları Gör
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-4">Henüz listelenecek bir ürün bulunamadı.</p>
            </div>
        }
    </div>
</div>